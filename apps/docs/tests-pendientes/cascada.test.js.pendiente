/**
 * La barra inferior salía descuadrada (corrida a la izquierda) y nadie lo
 * detectaba, porque el CSS compila igual: dos hojas distintas definían la
 * MISMA clase con posicionamientos incompatibles.
 *
 *   index.css   →  left: 50%  +  transform: translateX(-50%)
 *   system.css  →  left: 0; right: 0; margin: 0 auto
 *
 * system.css se importa después y tiene la misma especificidad, así que gana
 * su centrado por márgenes... pero el `transform` de index.css NO lo pisa
 * nadie y se sigue aplicando. Resultado: una caja ya centrada, desplazada
 * además media pantalla a la izquierda.
 *
 * Estos tests fijan la regla estructural que evita que vuelva a pasar:
 * cada clase de layout se define en UNA sola hoja.
 */
import { test, describe } from 'node:test'
import assert from 'node:assert/strict'
import fs from 'node:fs'
import path from 'node:path'

const RAIZ = path.resolve(import.meta.dirname, '..', '..')

/** Hojas en el orden real en que las importa main.jsx. El orden importa: es
 *  el que decide quién gana cuando la especificidad empata. */
const HOJAS = [
  'src/index.css',
  'src/styles/v90-fixes.css',
  'src/styles/ds-2026.css',
  'src/styles/system.css',
  'src/styles/v99-ux.css',
  'src/styles/shell.css',
  'src/styles/identidad.css',
]

const leer = (p) => fs.readFileSync(path.join(RAIZ, p), 'utf8')

/** Propiedades que deciden dónde y de qué tamaño se dibuja una caja. Si dos
 *  hojas pelean por una de estas, el resultado visual es impredecible. */
const LAYOUT = new Set([
  'position', 'top', 'right', 'bottom', 'left',
  'transform', 'display', 'width', 'max-width', 'margin', 'padding', 'z-index',
])

/** Parser mínimo: basta para reglas planas, que es todo lo que hay acá.
 *  Ignora bloques @media a propósito (ahí el solapamiento es legítimo). */
function declaraciones(css) {
  const limpio = css.replace(/\/\*[\s\S]*?\*\//g, '')
  const fuera = limpio.replace(/@media[^{]*\{(?:[^{}]*\{[^{}]*\})*[^{}]*\}/g, '')
  const salida = []
  const re = /([^{}]+)\{([^{}]*)\}/g
  let m
  while ((m = re.exec(fuera))) {
    if (m[1].includes('@')) continue
    const selectores = m[1].split(',').map((s) => s.trim())
    for (const d of m[2].split(';')) {
      const i = d.indexOf(':')
      if (i < 0) continue
      const prop = d.slice(0, i).trim()
      if (!prop) continue
      salida.push({ selectores, prop })
    }
  }
  return salida
}

/** Mapa clase+propiedad → hojas que la definen. Sólo clases simples. */
function mapaDeConflictos() {
  const mapa = new Map()
  for (const hoja of HOJAS) {
    for (const { selectores, prop } of declaraciones(leer(hoja))) {
      if (!LAYOUT.has(prop)) continue
      for (const sel of selectores) {
        if (!/^\.[a-zA-Z0-9_-]+$/.test(sel)) continue
        const clave = `${sel} { ${prop} }`
        if (!mapa.has(clave)) mapa.set(clave, new Set())
        mapa.get(clave).add(hoja)
      }
    }
  }
  return mapa
}

describe('cascada · una clase de layout se define en una sola hoja', () => {
  // 1 · El bug exacto que descuadró la barra.
  test('.navbar no se posiciona desde dos hojas a la vez', () => {
    const hojas = new Map()
    for (const hoja of HOJAS) {
      for (const { selectores, prop } of declaraciones(leer(hoja))) {
        if (!selectores.includes('.navbar')) continue
        if (!LAYOUT.has(prop)) continue
        if (!hojas.has(hoja)) hojas.set(hoja, [])
        hojas.get(hoja).push(prop)
      }
    }
    assert.equal(
      hojas.size,
      1,
      `.navbar debe posicionarse desde UNA hoja, no ${hojas.size}: ` +
        [...hojas.entries()].map(([h, p]) => `${h} (${p.join(', ')})`).join(' · '),
    )
  })

  // 2 · La combinación concreta que produce el desplazamiento: centrar por
  //     translateX y por margin auto a la vez se cancela mal.
  test('.navbar no mezcla centrado por transform con centrado por márgenes', () => {
    const props = new Set()
    for (const hoja of HOJAS) {
      for (const { selectores, prop } of declaraciones(leer(hoja))) {
        if (selectores.includes('.navbar')) props.add(prop)
      }
    }
    const porTransform = props.has('transform')
    const porMargenes = props.has('margin') && props.has('right')
    assert.ok(
      !(porTransform && porMargenes),
      'la barra se centra dos veces (translateX + margin auto): elegí una',
    )
  })

  // 3 · Las clases muertas no pueden volver: si nadie las usa en el JSX, no
  //     deben ocupar espacio ni competir en la cascada.
  test('no quedan reglas para clases de nav que el JSX ya no usa', () => {
    const jsx = fs
      .readdirSync(path.join(RAIZ, 'src'), { recursive: true })
      .filter((f) => String(f).endsWith('.jsx'))
      .map((f) => leer(path.join('src', String(f))))
      .join('\n')

    // Los comentarios sí pueden nombrarlas (explican por qué se borraron),
    // así que se quitan antes de buscar.
    const sinComentarios = (css) => css.replace(/\/\*[\s\S]*?\*\//g, '')

    for (const muerta of ['bs-nav', 'nav-bar', 'navbar-inner-4']) {
      const usadaEnJsx = jsx.includes(muerta)
      const enCss = HOJAS.some((h) => sinComentarios(leer(h)).includes(`.${muerta}`))
      if (!usadaEnJsx) {
        assert.ok(
          !enCss,
          `.${muerta} no se usa en ningún .jsx pero sigue definida en CSS`,
        )
      }
    }
  })

  // 4 · El recuadro punteado que rodeaba sólo a VISITAS. `border: none` en
  //     identidad.css dejaba el ancho `medium` latente; el
  //     `border-style: dashed` de .ghost en otra hoja (más específico) lo
  //     reactivaba y dibujaba una caja gruesa alrededor de un solo KPI.
  test('.bs-hoy-kpi.ghost no reactiva el borde con border-style suelto', () => {
    const culpables = []
    for (const hoja of HOJAS) {
      for (const { selectores, prop } of declaraciones(leer(hoja))) {
        if (!selectores.includes('.bs-hoy-kpi.ghost')) continue
        if (prop === 'border-style') culpables.push(`${hoja}`)
      }
    }
    assert.deepEqual(
      culpables,
      ['src/styles/identidad.css'],
      'border-style en .ghost sólo puede vivir en la hoja que define el ' +
        `borde base del KPI; aparece en: ${culpables.join(', ') || 'ninguna'}`,
    )
  })

  // 5 · Red general: que el número de conflictos no crezca. Hay deuda vieja
  //     que no se limpia en este bloque, así que se fija un techo y se baja.
  test('los conflictos de layout entre hojas no aumentan', () => {
    const conflictos = [...mapaDeConflictos().entries()]
      .filter(([, hojas]) => hojas.size > 1)
      .map(([clave]) => clave)
      .sort()

    const TECHO = 120
    assert.ok(
      conflictos.length <= TECHO,
      `${conflictos.length} conflictos de layout (techo ${TECHO}). ` +
        `Nuevos a revisar:\n  ${conflictos.slice(0, 12).join('\n  ')}`,
    )
  })
})
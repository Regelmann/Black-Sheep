/**
 * Editar un pedido existente NO puede crear uno nuevo.
 *
 * EL BUG
 * Cartera y Ruta abren "Mis pedidos de hoy" y pasan el pedido tocado a
 * PedidoSheet como `initialPedido`. El sheet guarda su id en
 * `pedidoExistenteId`... y nunca lo vuelve a leer: al confirmar llama a
 * guardarPedido() sin él, y guardarPedido() sólo sabe hacer insert.
 *
 * Resultado: el vendedor abre el pedido de un cliente, corrige una
 * cantidad, confirma — y en la base quedan DOS pedidos para el mismo
 * cliente el mismo día. Bodega prepara el doble.
 *
 * El síntoma visible era un aviso de lint ("pedidoExistenteId asignado
 * pero nunca usado"). Una variable sin leer suele ser basura inocente;
 * ésta era lógica de negocio que faltaba.
 */
import { test, describe, beforeEach } from 'node:test'
import assert from 'node:assert/strict'

let escrituras = []

function builder(tabla) {
  const ctx = { tabla, op: null, payload: null, filtros: {} }
  const chain = {
    insert(payload) { ctx.op = 'insert'; ctx.payload = payload; return chain },
    update(payload) { ctx.op = 'update'; ctx.payload = payload; return chain },
    eq(col, val) { ctx.filtros[col] = val; return chain },
    select() { ctx.select = true; return chain },
    maybeSingle() { return chain },
    then(resolve) {
      escrituras.push({ ...ctx })
      return Promise.resolve(resolve({ data: { id: ctx.filtros.id || 'nuevo-1' }, error: null }))
    },
  }
  return chain
}

const { registerSupabaseForTests } = await import('./supabase.js')
registerSupabaseForTests({ from: (t) => builder(t) })

const { guardarPedido } = await import('./pedido.js')

const LINEAS = [{ sku: 'ARZ', nombre: 'Arroz', cantidad: 4, precio: 1290 }]
const BASE = {
  ejecutivoId: 'eje-1',
  clienteKey: 'cli-9',
  nombreCliente: 'Almacén Don Pepe',
  lineas: LINEAS,
}

beforeEach(() => { escrituras = [] })

describe('guardarPedido · crear vs editar', () => {
  test('sin id previo inserta, como siempre', async () => {
    await guardarPedido({ ...BASE })
    assert.equal(escrituras.length, 1)
    assert.equal(escrituras[0].op, 'insert')
  })

  // El corazón del bug.
  test('con pedidoId actualiza, no duplica', async () => {
    await guardarPedido({ ...BASE, pedidoId: 'ped-77' })
    const ops = escrituras.map(e => e.op)
    assert.ok(
      !ops.includes('insert'),
      `editar un pedido existente no puede insertar otro (ops: ${ops.join(',')})`,
    )
    assert.equal(escrituras[0].op, 'update')
    assert.equal(escrituras[0].filtros.id, 'ped-77', 'el update tiene que filtrar por el id')
  })

  test('al actualizar no se pisa la fecha de creación', async () => {
    await guardarPedido({ ...BASE, pedidoId: 'ped-77' })
    assert.ok(
      !('creado_en' in escrituras[0].payload),
      'creado_en es del alta: reescribirlo falsea cuándo se tomó el pedido',
    )
  })

  test('el update manda las líneas corregidas', async () => {
    await guardarPedido({
      ...BASE,
      pedidoId: 'ped-77',
      lineas: [{ sku: 'ARZ', nombre: 'Arroz', cantidad: 9, precio: 1290 }],
    })
    assert.equal(escrituras[0].payload.lineas[0].cantidad, 9)
  })

  test('un pedido sin líneas sigue sin guardarse, tenga id o no', async () => {
    const r = await guardarPedido({ ...BASE, pedidoId: 'ped-77', lineas: [] })
    assert.equal(r.error, 'Sin líneas')
    assert.equal(escrituras.length, 0)
  })
})
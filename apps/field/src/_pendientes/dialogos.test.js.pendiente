/**
 * La app usaba los diálogos del navegador: un confirm() para borrar un
 * foco y tres alert() en Clientes.
 *
 * No es un detalle de estilo. Esas cajas las dibuja el navegador con su
 * propio aspecto, muestran el dominio arriba y rotulan el botón en el
 * idioma del sistema operativo, no en el de la app. En una demo delatan
 * al instante que hay algo sin terminar. Además bloquean el hilo de JS
 * mientras están abiertas.
 *
 * Estos tests fijan las decisiones que hacen que el reemplazo sea mejor
 * y no sólo distinto.
 */
import { test, describe } from 'node:test'
import assert from 'node:assert/strict'
import fs from 'node:fs'
import path from 'node:path'

const RAIZ = path.resolve(import.meta.dirname, '..', '..')
const leer = (p) => fs.readFileSync(path.join(RAIZ, p), 'utf8')

const CONFIRMAR = leer('src/ui/Confirmar.jsx')
const AVISO = leer('src/ui/Aviso.jsx')
const CSS = leer('src/styles/identidad.css')

/** Archivos de la app donde un diálogo nativo sería visible. */
function fuentesDeApp() {
  const out = []
  const rec = (dir) => {
    for (const e of fs.readdirSync(path.join(RAIZ, dir), { withFileTypes: true })) {
      const rel = path.join(dir, e.name)
      if (e.isDirectory()) rec(rel)
      else if (/\.jsx?$/.test(e.name) && !e.name.includes('.test.')) out.push(rel)
    }
  }
  rec('src')
  return out
}

describe('diálogos · la app no delega en el navegador', () => {
  test('no queda ningún confirm/alert/prompt en el código', () => {
    const culpables = []
    for (const f of fuentesDeApp()) {
      const sinComentarios = leer(f)
        .replace(/\/\*[\s\S]*?\*\//g, '')
        .replace(/\/\/.*$/gm, '')
      if (/(?:^|[^.\w])(window\.)?(confirm|alert|prompt)\s*\(/.test(sinComentarios)) {
        culpables.push(f)
      }
    }
    assert.deepEqual(culpables, [], `diálogos nativos en: ${culpables.join(', ')}`)
  })

  // Un confirm() nativo sólo ofrece "Aceptar/Cancelar". Cuando hay diez
  // focos parecidos, eso no dice QUÉ se está por borrar.
  test('la confirmación nombra la acción, no dice sólo "Sí"', () => {
    assert.match(CONFIRMAR, /confirmar\s*=\s*'Eliminar'/, 'debe traer una etiqueta explícita')
    const admin = leer('src/pages/Admin.jsx')
    assert.match(
      admin,
      /confirmar="Eliminar foco"/,
      'el botón debe decir qué elimina',
    )
    assert.match(
      admin,
      /detalle=\{`"\$\{focoABorrar\.foco\}"/,
      'el detalle debe nombrar el foco concreto',
    )
  })

  test('la acción destructiva se distingue de la salida segura', () => {
    assert.match(CSS, /\.bs-confirm-ok\.is-destructive\s*\{[^}]*var\(--danger\)/)
    assert.match(CSS, /\.bs-confirm-cancel\s*\{[^}]*var\(--surface\)/)
  })

  // Un error que se borra solo es un error que el vendedor se pierde.
  test('los errores no se autocierran; los éxitos sí', () => {
    const efecto = AVISO.slice(AVISO.indexOf('setTimeout'))
    const guarda = AVISO.slice(
      AVISO.lastIndexOf('useEffect(', AVISO.indexOf('setTimeout')),
      AVISO.indexOf('setTimeout'),
    )
    assert.match(
      guarda,
      /if \(esError[^)]*\) return undefined/,
      'un aviso de error no puede llegar a armar el temporizador',
    )
    assert.match(efecto, /setTimeout\(/, 'el éxito sí se cierra solo')
  })

  /**
   * Bug sutil: Cartera pasa `onCerrar={() => setAviso(null)}`, una función
   * nueva en cada render. Si el efecto del temporizador depende de
   * `onCerrar`, se limpia y se rearma en CADA render — y mientras el
   * usuario escribe en el buscador el aviso no se cierra nunca.
   *
   * Se guarda la última función en una ref y el efecto depende sólo de
   * lo que de verdad debe reiniciar la cuenta: el mensaje y su tipo.
   */
  test('el temporizador no se reinicia en cada render', () => {
    // El efecto del temporizador es el que contiene setTimeout, no el
    // que sincroniza la ref.
    const efecto = AVISO.slice(AVISO.indexOf('setTimeout'))
    const deps = efecto.slice(efecto.indexOf('}, ['), efecto.indexOf('])') + 2)
    assert.doesNotMatch(
      deps,
      /onCerrar/,
      'el efecto no puede depender de onCerrar: llega como flecha nueva ' +
        `en cada render y rearma la cuenta. Dependencias: ${deps}`,
    )
    assert.match(AVISO, /useRef/, 'la función se guarda en una ref')
  })

  test('el error se anuncia como alerta a los lectores de pantalla', () => {
    assert.match(AVISO, /role=\{esError \? 'alert' : 'status'\}/)
    assert.match(CONFIRMAR, /role="alertdialog"/)
    assert.match(CONFIRMAR, /aria-modal="true"/)
  })

  // El sheet sube desde abajo y sus botones son grandes: se usa con una
  // mano, que es como se usa la app en terreno.
  test('los botones de confirmación llegan a la mínima táctil', () => {
    const bloque = CSS.slice(CSS.indexOf('.bs-confirm-actions button'))
    const m = bloque.match(/min-height:\s*(\d+)px/)
    assert.ok(m, 'debe declarar min-height')
    assert.ok(Number(m[1]) >= 44, `min-height ${m[1]}px, mínimo 44`)
  })

  test('se respeta a quien pidió menos movimiento', () => {
    assert.match(CSS, /prefers-reduced-motion: reduce/)
  })

  /**
   * ZonePicker ya cerraba con Escape. Un diálogo modal que atrapa al
   * usuario sin esa salida es peor que el confirm() nativo, que sí la
   * tenía: se reemplazó una caja fea por una trampa.
   */
  test('la confirmación se puede cancelar con Escape', () => {
    assert.match(CONFIRMAR, /'Escape'/, 'debe escuchar la tecla Escape')
    assert.match(
      CONFIRMAR,
      /removeEventListener\('keydown'/,
      'y soltar el listener al desmontarse',
    )
  })

  // Tocar el fondo cancela; tocar el panel no debe cerrarlo por descuido.
  test('el fondo cancela y el panel no propaga el clic', () => {
    assert.match(CONFIRMAR, /onClick=\{onCancelar\}/)
    assert.match(CONFIRMAR, /onClick=\{\(e\) => e\.stopPropagation\(\)\}/)
  })
})
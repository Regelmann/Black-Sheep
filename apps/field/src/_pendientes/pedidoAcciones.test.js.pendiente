/**
 * Con el pedido vacío, los cuatro botones del sheet estaban habilitados.
 * Tocar "Enviar a bodega" llamaba al backend, que rechazaba con el string
 * "Sin líneas", y el vendedor veía un recuadro rojo de error por haber
 * tocado un botón que la app le ofrecía como válido.
 *
 * En terreno eso es peor que feo: parece que la app falló. Y en una demo
 * es exactamente el clic que va a hacer quien la esté probando, porque el
 * botón naranja es lo único que llama la atención en una pantalla vacía.
 *
 * La regla: un botón que no se puede usar no se ofrece habilitado.
 */
import { test, describe } from 'node:test'
import assert from 'node:assert/strict'
import { accionesPedido } from './pedidoAcciones.js'
import { guardarPedido } from '../lib/pedido.js'

const linea = (extra = {}) => ({
  sku: 'ARZ-001',
  nombre: 'Arroz Grado 2 · 1kg',
  cantidad: 3,
  precio: 1290,
  ...extra,
})

describe('sheet de pedido · no se ofrece lo que no se puede hacer', () => {
  test('pedido vacío: las cuatro acciones quedan deshabilitadas', () => {
    const a = accionesPedido({ lineas: [] })
    assert.equal(a.puedeEnviar, false)
    assert.equal(a.puedeGuardar, false)
    assert.equal(a.puedePdf, false)
    assert.equal(a.puedeWhatsApp, false)
  })

  test('pedido vacío: se explica qué falta, no se muestra un error', () => {
    const a = accionesPedido({ lineas: [] })
    assert.ok(a.motivo, 'tiene que haber un motivo visible')
    assert.match(a.motivo, /producto/i)
    // El motivo es una instrucción, no un diagnóstico de fallo.
    assert.doesNotMatch(a.motivo, /error|falló|inválido/i)
  })

  test('con una línea real se habilita todo', () => {
    const a = accionesPedido({ lineas: [linea()] })
    assert.equal(a.puedeEnviar, true)
    assert.equal(a.motivo, null)
    assert.equal(a.lineasValidas, 1)
  })

  test('una línea en cantidad 0 no habilita nada', () => {
    const a = accionesPedido({ lineas: [linea({ cantidad: 0 })] })
    assert.equal(a.puedeEnviar, false)
  })

  test('mientras se envía no se puede volver a tocar', () => {
    const a = accionesPedido({ lineas: [linea()], busy: true })
    assert.equal(a.puedeEnviar, false)
  })

  /**
   * El punto clave: la condición del front tiene que coincidir con la que
   * aplica el backend. Si divergen, o bien se bloquean pedidos válidos, o
   * bien vuelve el recuadro rojo.
   */
  test('la regla del front coincide con la que rechaza el backend', async () => {
    const casos = [
      { lineas: [], nombre: 'vacío' },
      { lineas: [linea({ cantidad: 0 })], nombre: 'cantidad 0' },
      { lineas: [{ cantidad: 2 }], nombre: 'sin nombre ni sku' },
    ]
    for (const c of casos) {
      assert.equal(
        accionesPedido({ lineas: c.lineas }).puedeEnviar,
        false,
        `el front debería bloquear el caso "${c.nombre}"`,
      )
      const r = await guardarPedido({
        ejecutivoId: 'demo-user',
        lineas: c.lineas,
        estado: 'enviado',
      })
      assert.ok(
        r.error,
        `el backend también rechaza "${c.nombre}" — las dos reglas coinciden`,
      )
    }
  })
})
new file mode 100644
index 0000000..e4a478d
--- /dev/null
+++ b/apps/field/eslint.config.js
@@ -0,0 +1,98 @@
+/**
+ * ESLint — la barrera que faltaba.
+ *
+ * POR QUÉ EXISTE
+ * En V10.0, handleCompletar() usaba una variable `data` que no existía en su
+ * scope. Rompía TODO cierre de visita hecho sin señal. Pasó:
+ *   · 76 tests en verde   (ninguno tocaba ese handler)
+ *   · guard.js en verde   (R6 sólo verifica que haya `return`)
+ *   · vite build en verde (Rollup no hace análisis de scope)
+ *
+ * `no-undef` —una regla de 2013— lo marcaba en 3 líneas.
+ *
+ * CRITERIO DE CONFIGURACIÓN
+ * Sólo se activan como ERROR las reglas que detectan BUGS, no estilo. El
+ * proyecto no necesita otra discusión sobre comillas; necesita que no se
+ * pueda commitear código roto. El formato queda fuera a propósito.
+ */
+import js from '@eslint/js'
+import globals from 'globals'
+import react from 'eslint-plugin-react'
+import reactHooks from 'eslint-plugin-react-hooks'
+
+export default [
+  {
+    ignores: ['dist/**', 'node_modules/**', 'public/sw.js', 'scripts/**'],
+  },
+
+  js.configs.recommended,
+
+  {
+    files: ['**/*.{js,jsx}'],
+    languageOptions: {
+      ecmaVersion: 2022,
+      sourceType: 'module',
+      globals: { ...globals.browser, ...globals.es2021 },
+      parserOptions: { ecmaFeatures: { jsx: true } },
+    },
+    settings: { react: { version: '18.3' } },
+    plugins: { react, 'react-hooks': reactHooks },
+    rules: {
+      // ── Bugs reales ───────────────────────────────────────────────────
+      // La regla que habría atrapado el bug de handleCompletar.
+      'no-undef': 'error',
+      'no-unsafe-optional-chaining': 'error',
+      'no-constant-binary-expression': 'error',
+      'no-self-compare': 'error',
+      'no-unreachable-loop': 'error',
+      'no-template-curly-in-string': 'error',
+
+      // Las tres de abajo tienen falsos positivos conocidos en este código y
+      // se dejan en 'warn' a propósito. La alternativa —apagarlas— perdería
+      // los casos verdaderos; dejarlas en 'error' obligaría a reescribir
+      // lógica correcta sólo para callar al linter.
+      //
+      // no-unmodified-loop-condition: los bucles de días hábiles mutan el
+      //   objeto Date (cur.setDate) sin reasignar la variable. Es correcto.
+      // no-useless-assignment: marca inicializaciones defensivas (let x = null
+      //   antes de un try/catch que siempre asigna). Es un patrón deliberado.
+      // require-atomic-updates: marca `x = await f()` sobre estado externo.
+      //   En React con setState suele ser inocuo, pero puede esconder races
+      //   reales — se revisa en Fase 2 al migrar a TanStack Query.
+      'no-unmodified-loop-condition': 'warn',
+      'no-useless-assignment': 'warn',
+      'require-atomic-updates': 'warn',
+
+      // Perder la causa original de un error dificulta depurar en terreno.
+      'preserve-caught-error': 'warn',
+
+      // Un catch vacío se traga el error. Es el patrón que R3 del guard
+      // nació para castigar; acá se prohíbe salvo comentario explícito.
+      'no-empty': ['error', { allowEmptyCatch: false }],
+
+      // ── React ─────────────────────────────────────────────────────────
+      ...react.configs.flat.recommended.rules,
+      ...react.configs.flat['jsx-runtime'].rules,
+      'react/prop-types': 'off',        // no se usan PropTypes; TS llega en Fase 2
+      'react/no-unescaped-entities': 'off',
+
+      // Con 25 useState en Ruta.jsx, las deps mal declaradas son el
+      // próximo bug. Hoy avisa; pasa a error cuando la deuda esté en 0.
+      'react-hooks/rules-of-hooks': 'error',
+      'react-hooks/exhaustive-deps': 'warn',
+
+      // ── Ruido conocido, se limpia por fases ───────────────────────────
+      'no-unused-vars': ['warn', {
+        argsIgnorePattern: '^_',
+        varsIgnorePattern: '^_',
+        caughtErrorsIgnorePattern: '^_',
+      }],
+    },
+  },
+
+  // Los tests corren en Node, no en el browser.
+  {
+    files: ['**/*.test.js'],
+    languageOptions: { globals: { ...globals.node } },
+  },
+]

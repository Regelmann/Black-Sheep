diff --git a/apps/field/src/chrome/ErrorBoundary.jsx b/apps/field/src/chrome/ErrorBoundary.jsx
new file mode 100644
index 0000000..4ce9e32
--- /dev/null
+++ b/apps/field/src/chrome/ErrorBoundary.jsx
@@ -0,0 +1,93 @@
+import { Component } from 'react'
+import { BUILD_STAMP } from '../lib/buildStamp.js'
+
+/**
+ * Red de contención de la UI.
+ *
+ * POR QUÉ EXISTE
+ * Sin esto, cualquier excepción durante el render desmonta el árbol entero y
+ * React deja el DOM VACÍO: pantalla blanca, sin botones, sin forma de volver.
+ * Para un vendedor en la calle eso equivale a que la app dejó de existir —
+ * y la respuesta natural es volver al cuaderno.
+ *
+ * QUÉ ATRAPA Y QUÉ NO
+ *  ✅ Errores de render, de métodos del ciclo de vida y de constructores.
+ *  ❌ Errores dentro de handlers (onClick), async/await y setTimeout.
+ *     Esos siguen necesitando try/catch en el sitio.
+ *
+ * DECISIÓN DE DISEÑO: el boundary va POR RUTA, no sólo en la raíz. Si
+ * Gerencia explota, "Hoy" y la cola offline deben seguir funcionando. Un
+ * único boundary global convertiría un bug de una pantalla secundaria en una
+ * caída total de la app.
+ */
+export class ErrorBoundary extends Component {
+  constructor(props) {
+    super(props)
+    this.state = { error: null }
+  }
+
+  static getDerivedStateFromError(error) {
+    return { error }
+  }
+
+  componentDidCatch(error, info) {
+    // Sin esto el error muere en la consola de un teléfono que nadie mira.
+    console.error(`[ErrorBoundary:${this.props.nombre || 'app'}]`, error, info?.componentStack)
+
+    // Enganche para Sentry (Fase 0.5). Se llama sólo si está instalado, así
+    // que el boundary funciona igual sin telemetría configurada.
+    if (typeof window !== 'undefined' && window.Sentry?.captureException) {
+      window.Sentry.captureException(error, {
+        tags: { vista: this.props.nombre || 'app', build: BUILD_STAMP },
+        extra: { componentStack: info?.componentStack },
+      })
+    }
+  }
+
+  reintentar = () => {
+    this.setState({ error: null })
+  }
+
+  render() {
+    if (!this.state.error) return this.props.children
+
+    const { nombre } = this.props
+
+    return (
+      <div className="bs-error-boundary" role="alert">
+        <div className="bs-eb-card">
+          <div className="bs-eb-icon" aria-hidden="true">⚠</div>
+
+          <h2 className="bs-eb-title">Esta pantalla tuvo un problema</h2>
+
+          <p className="bs-eb-body">
+            {nombre ? <>Falló <strong>{nombre}</strong>. </> : null}
+            El resto de la app sigue funcionando y{' '}
+            <strong>lo que registraste sin señal no se perdió</strong>: sigue en
+            la cola y se sube cuando vuelvas a tener red.
+          </p>
+
+          <div className="bs-eb-actions">
+            <button className="bs-eb-btn bs-eb-btn-primary" onClick={this.reintentar}>
+              Reintentar
+            </button>
+            <a className="bs-eb-btn" href="/">
+              Volver a Hoy
+            </a>
+          </div>
+
+          {/* El vendedor no lee esto, pero se lo dicta a soporte por teléfono. */}
+          <details className="bs-eb-details">
+            <summary>Detalle técnico</summary>
+            <p className="bs-eb-stamp">{BUILD_STAMP}</p>
+            <pre className="bs-eb-pre">
+              {String(this.state.error?.message || this.state.error)}
+            </pre>
+          </details>
+        </div>
+      </div>
+    )
+  }
+}
+
+export default ErrorBoundary

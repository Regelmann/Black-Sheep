index 0000000..0e95736
--- /dev/null
+++ b/apps/field/src/lib/syncHandlers.test.js
@@ -0,0 +1,253 @@
+/**
+ * Contrato de los handlers del outbox — con el handler REAL, no una réplica.
+ *
+ * POR QUÉ ESTE ARCHIVO EXISTE
+ * offline.test.js valida el bucle de drenaje usando handlers simulados. Eso
+ * dejó un hueco: nadie ejecutaba nunca el código de syncHandlers.js.
+ *
+ * En V10.0, handleCompletar() referenciaba una variable `data` inexistente
+ * en su scope → ReferenceError en TODO cierre de visita hecho sin señal.
+ * 76 tests en verde, guard en verde, build en verde. Nadie lo vio.
+ *
+ * Estos tests importan el módulo de verdad y le inyectan un doble de
+ * Supabase, así que un ReferenceError vuelve a fallar el CI.
+ */
+import { test, describe, beforeEach } from 'node:test'
+import assert from 'node:assert/strict'
+
+/* ── Doble de Supabase ──────────────────────────────────────────────────
+   Imita el encadenamiento de PostgREST: from().update().eq().select()
+   El builder es "thenable": se resuelve con { data, error } igual que el real.
+   ──────────────────────────────────────────────────────────────────── */
+let escrituras = []
+let respuestas = {}
+
+function builder(tabla) {
+  const ctx = { tabla, op: null, payload: null, filtros: {} }
+  const chain = {
+    update(payload) { ctx.op = 'update'; ctx.payload = payload; return chain },
+    insert(payload) { ctx.op = 'insert'; ctx.payload = payload; return chain },
+    eq(col, val) { ctx.filtros[col] = val; return chain },
+    select() { ctx.select = true; return chain },
+    then(resolve) {
+      escrituras.push({ ...ctx })
+      const r = respuestas[tabla] ?? { data: [{ id: `${tabla}-1` }], error: null }
+      return Promise.resolve(resolve(r))
+    },
+  }
+  return chain
+}
+
+const supabaseFake = { from: (tabla) => builder(tabla) }
+
+// Inyecta el doble antes de que el módulo bajo prueba resuelva `supabase`.
+const { registerSupabaseForTests } = await import('./supabase.js')
+registerSupabaseForTests(supabaseFake)
+
+const {
+  handleCompletar,
+  handleNota,
+  handleCheckin,
+  handlePedido,
+  handleNoVenta,
+  syncHandlers,
+} = await import('./syncHandlers.js')
+
+beforeEach(() => {
+  escrituras = []
+  respuestas = {}
+})
+
+describe('handleCompletar · cierre de visita offline', () => {
+  test('REGRESIÓN V10.0: no lanza ReferenceError con payload típico', async () => {
+    // El bug original explotaba justo acá. Si `data` vuelve a quedar
+    // sin declarar, esto tira ReferenceError y el CI se pone rojo.
+    const res = await handleCompletar({
+      type: 'completar',
+      payload: { visita_id: 'v-1', checkin_id: 'c-1', resultado: 'pedido' },
+    })
+    assert.equal(res.ok, true, 'un cierre de visita válido debe confirmarse')
+  })
+
+  test('actualiza check-in y visita, y confirma con .select()', async () => {
+    await handleCompletar({
+      payload: { visita_id: 'v-9', checkin_id: 'c-9', resultado: 'pedido', hora_fin: '2026-01-01T10:00:00Z' },
+    })
+
+    const ck = escrituras.find(e => e.tabla === 'checkins')
+    assert.ok(ck, 'debe escribir en checkins')
+    assert.equal(ck.filtros.id, 'c-9')
+    assert.equal(ck.payload.resultado, 'pedido')
+    assert.equal(ck.payload.hora_fin, '2026-01-01T10:00:00Z')
+    assert.ok(ck.select, 'sin .select() no hay confirmación real de escritura')
+
+    const vi = escrituras.find(e => e.tabla === 'visitas')
+    assert.ok(vi, 'debe escribir en visitas')
+    assert.equal(vi.payload.estado, 'visitada')
+    assert.ok(vi.select, 'sin .select() no hay confirmación real de escritura')
+  })
+
+  test('un check-in offline_ no se manda al servidor', async () => {
+    // Los ids "offline_*" son locales: no existen en la base todavía.
+    const res = await handleCompletar({
+      payload: { visita_id: 'v-2', checkin_id: 'offline_abc' },
+    })
+    assert.equal(escrituras.some(e => e.tabla === 'checkins'), false)
+    assert.equal(res.ok, true, 'la visita igual debe cerrarse')
+  })
+
+  test('error de red → ok:false y el item SIGUE en la cola', async () => {
+    respuestas.checkins = { data: null, error: { message: 'Failed to fetch' } }
+    const res = await handleCompletar({ payload: { visita_id: 'v-3', checkin_id: 'c-3' } })
+    assert.equal(res.ok, false)
+    assert.match(res.error, /Failed to fetch/)
+    assert.notEqual(res.descartar, true, 'un fallo de red debe reintentarse, no descartarse')
+  })
+
+  test('update que afecta 0 filas NO se cuenta como éxito', async () => {
+    // PostgREST devuelve [] sin error si el id no existe o RLS lo oculta.
+    // Tratarlo como éxito sería perder el cierre de visita en silencio.
+    respuestas.checkins = { data: [], error: null }
+    const res = await handleCompletar({ payload: { checkin_id: 'c-inexistente' } })
+    assert.equal(res.ok, false)
+    assert.match(res.error, /no encontrado|sin confirmar/i)
+  })
+
+  test('payload sin destino se descarta en vez de bloquear la cola', async () => {
+    const res = await handleCompletar({ payload: {} })
+    assert.equal(res.ok, false)
+    assert.equal(res.descartar, true, 'reintentar 25 veces un item corrupto tapa el problema real')
+  })
+
+  test('nunca devuelve undefined (contrato de flushActionQueue)', async () => {
+    // R6 del guard: un handler que devuelve undefined deja la cola eterna.
+    for (const payload of [{}, { visita_id: 'v' }, { checkin_id: 'c' }]) {
+      const res = await handleCompletar({ payload })
+      assert.equal(typeof res, 'object')
+      assert.equal(typeof res.ok, 'boolean')
+    }
+  })
+})
+
+describe('handleNota', () => {
+  test('inserta y devuelve ok', async () => {
+    const res = await handleNota({ payload: { cliente_key: 'k1', texto: 'hola' } })
+    assert.equal(res.ok, true)
+    assert.equal(escrituras[0].tabla, 'notas_cliente')
+  })
+
+  test('error → ok:false, no undefined', async () => {
+    respuestas.notas_cliente = { data: null, error: { message: 'RLS' } }
+    const res = await handleNota({ payload: { texto: 'x' } })
+    assert.equal(res.ok, false)
+    assert.equal(res.error, 'RLS')
+  })
+})
+
+describe('handleCheckin · idempotencia', () => {
+  test('inserta y confirma con la fila devuelta', async () => {
+    const res = await handleCheckin({
+      client_op_id: 'op-1',
+      payload: { visita_id: 'v-1', cliente_key: 'k-1', lat: -34.38, lng: -72.0 },
+    })
+    assert.equal(res.ok, true)
+    assert.equal(escrituras[0].tabla, 'checkins')
+    // La llave de idempotencia DEBE viajar: sin ella, un reintento duplica.
+    assert.equal(escrituras[0].payload.client_op_id, 'op-1')
+  })
+
+  test('error 23505 (duplicado) se trata como ÉXITO, no como fallo', async () => {
+    // El insert ya había llegado; se perdió la respuesta. El dato está en la
+    // base: devolver ok:false dejaría el item reintentando para siempre.
+    respuestas.checkins = { data: null, error: { code: '23505', message: 'duplicate key' } }
+    const res = await handleCheckin({ client_op_id: 'op-2', payload: { visita_id: 'v-2' } })
+    assert.equal(res.ok, true)
+    assert.equal(res.yaExistia, true)
+  })
+
+  test('error de red NO se confunde con duplicado', async () => {
+    respuestas.checkins = { data: null, error: { message: 'Failed to fetch' } }
+    const res = await handleCheckin({ client_op_id: 'op-3', payload: { visita_id: 'v-3' } })
+    assert.equal(res.ok, false, 'un fallo de red debe reintentarse')
+  })
+
+  test('insert sin fila devuelta no cuenta como éxito', async () => {
+    respuestas.checkins = { data: [], error: null }
+    const res = await handleCheckin({ client_op_id: 'op-4', payload: { visita_id: 'v-4' } })
+    assert.equal(res.ok, false)
+  })
+})
+
+describe('handlePedido · lo que mueve plata', () => {
+  test('payload vacío se descarta (no bloquea la cola)', async () => {
+    const res = await handlePedido({ payload: {} })
+    assert.equal(res.ok, false)
+    assert.equal(res.descartar, true)
+  })
+
+  test('calcula total_estimado desde las líneas', async () => {
+    await handlePedido({
+      payload: {
+        ejecutivoId: 'e-1',
+        clienteKey: 'k-1',
+        lineas: [

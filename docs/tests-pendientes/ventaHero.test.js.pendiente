/**
 * VentaHero mostraba dos mensajes que se contradicen al mismo tiempo:
 *
 *     0%  Crítico            Meta $0
 *     Meta cumplida · $0 por encima
 *
 * Pasa cuando la meta es 0 (vendedor sin meta cargada, o zona nueva).
 * El pie se decide con `falta = max(0, meta - venta)`: si la meta es 0,
 * falta es 0, y el componente concluye que la meta está cumplida. Al
 * mismo tiempo el porcentaje es 0% y el estado ATRASADO/Crítico.
 *
 * En una demo esto es de lo peor que puede aparecer: el panel principal
 * se contradice solo y el número grande deja de ser creíble.
 *
 * La regla se probó contra `tonoDeVenta`, no contra el texto del .jsx:
 * un test que busca un identificador en el archivo pasa igual aunque la
 * lógica esté rota.
 */
import { test, describe } from 'node:test'
import assert from 'node:assert/strict'
import fs from 'node:fs'
import { tonoDeVenta, sinMetaCargada } from './ventaTono.js'
import { calcGoal } from '../lib/calculations/goal.js'

/** Arma el goal real y pide el tono, como hace el componente. */
function evaluar({ venta, meta, pasados = 22, total = 26 }) {
  const goal = calcGoal({
    sold: venta,
    target: meta,
    unit: 'CLP',
    businessDaysElapsed: pasados,
    businessDaysInMonth: total,
  })
  return tonoDeVenta({
    venta,
    meta,
    goal,
    dias: { restantes: Math.max(0, total - pasados) },
  })
}

describe('VentaHero · sin meta cargada no se inventa un resultado', () => {
  // 1 · El caso exacto de la captura: meta 0, venta 0, fin de mes.
  test('meta 0 no dice "Meta cumplida"', () => {
    const r = evaluar({ venta: 0, meta: 0 })
    assert.notEqual(r.pie, 'CUMPLIDA', 'sin meta nadie cumplió nada')
    assert.equal(r.pie, 'SIN_META')
  })

  // 2 · Y tampoco puede pintar la alarma roja: no hay contra qué comparar.
  test('meta 0 no muestra el estado Crítico', () => {
    const r = evaluar({ venta: 0, meta: 0 })
    assert.notEqual(r.clave, 'CRITICO')
    assert.equal(r.tono.texto, 'Sin meta')
  })

  // 3 · Las dos afirmaciones no pueden convivir nunca, con ningún dato.
  test('nunca coexisten "Crítico" y "Meta cumplida"', () => {
    const casos = [
      { venta: 0, meta: 0 },
      { venta: 0, meta: 100 },
      { venta: 50, meta: 100 },
      { venta: 100, meta: 100 },
      { venta: 500, meta: 100 },
      { venta: 0, meta: 0, pasados: 1, total: 26 },
      { venta: 10, meta: 0 },
    ]
    for (const c of casos) {
      const r = evaluar(c)
      assert.ok(
        !(r.clave === 'CRITICO' && r.pie === 'CUMPLIDA'),
        `contradicción con ${JSON.stringify(c)}: ${r.clave} + ${r.pie}`,
      )
    }
  })

  // 4 · Con meta real, el comportamiento de siempre no cambia.
  test('con meta real el panel sigue funcionando', () => {
    assert.equal(evaluar({ venta: 100, meta: 500 }).pie, 'FALTA')
    assert.equal(evaluar({ venta: 600, meta: 500 }).pie, 'CUMPLIDA')
    assert.equal(evaluar({ venta: 600, meta: 500 }).clave, 'SUPERADO')
  })

  test('fin de mes muy por debajo del ritmo sí es Crítico', () => {
    const r = evaluar({ venta: 10, meta: 1000, pasados: 25, total: 26 })
    assert.equal(r.clave, 'CRITICO')
    assert.equal(r.pie, 'FALTA')
  })

  /**
   * El arreglo visual escondió el "0%" y la barra, pero el aria-label
   * seguía diciendo "0% de la meta": quien usa lector de pantalla oía la
   * contradicción que acabábamos de quitar de la pantalla. Un arreglo a
   * medias es peor, porque parece resuelto.
   */
  test('sin meta, el texto accesible tampoco menciona un porcentaje', () => {
    const fuente = fs.readFileSync(
      new URL('./VentaHero.jsx', import.meta.url),
      'utf8',
    )
    const label = fuente.slice(
      fuente.indexOf('aria-label={'),
      fuente.indexOf('>', fuente.indexOf('aria-label={')),
    )
    assert.match(
      label,
      /sinMeta/,
      'el aria-label debe contemplar el caso sin meta en vez de anunciar ' +
        'siempre "N% de la meta"',
    )
  })

  // 5 · Meta ausente en todas sus formas (null, undefined, '', 0, negativa).
  test('detecta la meta ausente en cualquier formato', () => {
    for (const m of [0, null, undefined, '', -5, NaN]) {
      assert.equal(sinMetaCargada(m), true, `${m} debería contar como sin meta`)
    }
    assert.equal(sinMetaCargada(100), false)
  })
})
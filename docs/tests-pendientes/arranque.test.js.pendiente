/**
 * Arranque de la app: que un fallo temprano NUNCA sea una pantalla en blanco.
 *
 * El caso real: sin archivo .env, buildClient() devuelve null y el Proxy de
 * supabase.js lanzaba "Cannot read properties of null (reading 'auth')" en el
 * primer useEffect de App.jsx. Como los ErrorBoundary viven POR RUTA, el error
 * ocurría antes de que se montara cualquiera de ellos: React dejaba #root
 * vacío y el log del server salía limpio, porque todo el fallo pasa en el
 * navegador. Diagnosticarlo llevó revisar service worker, caché y build.
 *
 * Dos defensas, una por causa:
 *   1. el Proxy explica qué falta en vez de un TypeError sobre null
 *   2. hay un ErrorBoundary de raíz que pinta ese mensaje
 */
import { test, describe } from 'node:test'
import assert from 'node:assert/strict'
import { readFileSync } from 'node:fs'

const SUPABASE = readFileSync(new URL('./supabase.js', import.meta.url), 'utf8')
const MAIN = readFileSync(new URL('../main.jsx', import.meta.url), 'utf8')

describe('arranque sin credenciales', () => {
  test('el Proxy de supabase no deja pasar un cliente null', () => {
    const get = SUPABASE.slice(SUPABASE.indexOf('get(_t, prop)'))
    const cuerpo = get.slice(0, get.indexOf('\n    },'))
    assert.match(
      cuerpo,
      /if \(!c\)[\s\S]*throw new Error/,
      'sin la guarda, c[prop] lanza un TypeError sobre null que no dice nada',
    )
  })

  test('el mensaje dice qué hacer, no sólo qué falló', () => {
    const i = SUPABASE.indexOf('Supabase sin configurar')
    assert.ok(i > 0, 'falta el mensaje explicativo')
    const msg = SUPABASE.slice(i, i + 400)
    assert.match(msg, /VITE_SUPABASE_URL/, 'nombra la variable que falta')
    assert.match(msg, /\.env/, 'dice dónde se configura')
    assert.match(msg, /VITE_DEMO=1/, 'ofrece la salida para revisar la UI sin backend')
  })

  // Reproducción del crash exacto, con el Proxy real del archivo.
  test('el TypeError original sobre null ya no ocurre', () => {
    const supabase = new Proxy({}, {
      get(_t, prop) {
        const c = null // buildClient() sin credenciales
        if (!c) throw new Error('Supabase sin configurar: falta VITE_SUPABASE_URL')
        return c[prop]
      },
    })
    assert.throws(
      () => supabase.auth.getSession(),
      (e) => {
        assert.ok(
          !/Cannot read properties of null/.test(e.message),
          `sigue siendo el TypeError mudo: ${e.message}`,
        )
        return /sin configurar/.test(e.message)
      },
    )
  })
})

describe('red de contención en la raíz', () => {
  test('App va envuelta en un ErrorBoundary', () => {
    assert.match(MAIN, /import \{ ErrorBoundary \}/, 'falta el import')
    // Se busca el bloque de render, no una forma concreta de arrancar.
    // Antes se cortaba desde 'listoDemo.finally'; si ese patrón no existe,
    // indexOf devuelve -1 y slice(-1) deja UN carácter: el test pasaba a
    // evaluar una cadena vacía y fallaba sin motivo real.
    const i = MAIN.indexOf('createRoot')
    const render = i > -1 ? MAIN.slice(i) : MAIN
    const eb = render.indexOf('<ErrorBoundary')
    const app = render.indexOf('<App')
    assert.ok(eb > -1, 'no hay ErrorBoundary en el arranque')
    assert.ok(eb < app, 'el boundary tiene que envolver a App, no ir después')
  })

  test('el boundary envuelve también a los providers', () => {
    const i = MAIN.indexOf('createRoot')
    const render = i > -1 ? MAIN.slice(i) : MAIN
    const eb = render.indexOf('<ErrorBoundary')
    const qc = render.indexOf('<QueryClientProvider')
    assert.ok(
      eb < qc,
      'si el provider queda por fuera, un fallo al crearlo vuelve a dar pantalla blanca',
    )
  })
})